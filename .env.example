# Copy to .env (or export these) and adjust. Values shown are the defaults.

TASKDECK_HOST=127.0.0.1
TASKDECK_PORT=6090
TASKDECK_DATA=./data

# Agent runner: none (default, board only) | claude | echo (demo/tests)
TASKDECK_RUNNER=none

# Optional shared secret. If set, mutating/run requests must send it in the
# X-TaskDeck-Token header.
# TASKDECK_TOKEN=

# Used only when TASKDECK_RUNNER=claude (see SECURITY.md before enabling):
# CLAUDE_BIN=claude
# TASKDECK_RUN_CWD=./data/workspace
# TASKDECK_RUN_TIMEOUT=600
# TASKDECK_RUN_MAXBYTES=100000
